# frontend/.env -- read by docker compose (env_file for the frontend dev service) and by
# Vite. Only these two variables are read (src/main.tsx). In production both are Docker
# build args (frontend/Dockerfile), set in docker-compose.coolify.yml.

# Required. Clerk publishable key (pk_test_... for dev).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Optional. 'true' renders the maintenance screen instead of the app.
VITE_MAINTENANCE_MODE=false

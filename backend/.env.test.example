# backend/.env.test -- read by docker compose (env_file for test-db and test-runner under
# `just test`) and by Settings inside the runner. Mirrors the env block in
# .github/workflows/ci.yml. Unit and api tests mock every external call.

# --- Postgres container (must match the docker-compose.yml test-db healthcheck) ---
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_pass
POSTGRES_DB=arxiv_rag_test
# Settings.postgres_url; `test-db` is the compose service name.
POSTGRES_URL=postgresql+asyncpg://test_user:test_pass@test-db:5432/arxiv_rag_test
# Read directly by tests/integration/conftest.py (not via Settings). Required for
# `just test tests/integration`.
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_pass@test-db:5432/arxiv_rag_test

# --- Required Settings field (JWT verification is mocked) ---
CLERK_DOMAIN=test-clerk.clerk.accounts.dev

# --- Provider keys: never called; dummies keep client constructors happy ---
OPENAI_API_KEY=sk-test-key-not-used-in-unit-tests

# --- App ---
DEBUG=true
LOG_LEVEL=DEBUG

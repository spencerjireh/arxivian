# Docker Configuration
POSTGRES_USER=arxiv_user
POSTGRES_PASSWORD=arxiv_password
POSTGRES_DB=arxiv_rag
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/arxiv_rag

# LLM Configuration (LiteLLM-format: "provider/model"). One model for every chat and
# triage call; there is no per-request model selection.
DEFAULT_LLM_MODEL=openai/gpt-5-nano
# Override model for structured-output calls (classify, evaluate, triage). Omit = use default.
STRUCTURED_OUTPUT_MODEL=openai/gpt-5-nano
DEFAULT_TEMPERATURE=0.3

# Provider API Keys
OPENAI_API_KEY=sk-your-key-here

# Jina Embeddings
JINA_API_KEY=jina_your-key-here

# Semantic Scholar (demand signal -- citation velocity)
# Optional: leave blank to use the keyless public pool (tighter rate limits).
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_CACHE_TTL_SECONDS=604800
# Keyless pool is ~1 req/s shared; this spaces our calls across workers (Redis slot)
SEMANTIC_SCHOLAR_MIN_INTERVAL_MS=1500
# Nightly retry of demand lookups that soft-failed to NULL
DEMAND_BACKFILL_SCHEDULE_CRON=0 4 * * *
DEMAND_BACKFILL_BATCH_SIZE=200

# TypeSafe Jev (Stage 2 scoring judgments: method clarity, feasibility, data gate, attributes)
# Required for scoring. Chat and Stage 1 triage do not use it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT_SECONDS=60
# On-demand scoring lock TTL (paper detail); the score task releases it early
ONDEMAND_SCORE_LOCK_SECONDS=1800

# Search Configuration
DEFAULT_TOP_K=3
RRF_K=60

# Chunking Configuration
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=100
MIN_CHUNK_WORDS=100

# Agent Configuration (paper-scoped chat)
GUARDRAIL_THRESHOLD=75
MAX_ITERATIONS=5
CONVERSATION_WINDOW=5

# CORS (comma-separated origins; leave empty to block all cross-origin requests)
CORS_ORIGINS=http://localhost:5173

# Application
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO
# Maintenance curtain: when true, all API routes except health return 503 (pivot).
MAINTENANCE_MODE=false

# Tracing (Pydantic Logfire). Leave the token empty to export nothing; with a token every
# request, SQL statement, LangGraph node, LLM call and Celery task is traced (prompts included).
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=dev

# Clerk Authentication
CLERK_DOMAIN=your-app.clerk.accounts.dev
CLERK_JWT_AUDIENCE=
CLERK_WEBHOOK_SECRET=

# API Authentication
API_KEY=

# Celery/Redis
# REDIS_PASSWORD is required in production (docker-compose.coolify.yml).
# Not needed for local dev -- the dev compose has no requirepass.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIMEOUT=600

# Scheduled jobs
INGEST_SCHEDULE_CRON=0 2 * * *
CLEANUP_SCHEDULE_CRON=0 3 * * *
CLEANUP_RETENTION_DAYS=90

# Stage 1 triage (scoring pipeline entry point)
TRIAGE_SCHEDULE_CRON=0 6 * * 1
TRIAGE_CATEGORIES=["cs.LG", "cs.CL", "cs.CV", "cs.AI"]
TRIAGE_LOOKBACK_DAYS=7
TRIAGE_MAX_PER_CATEGORY=100

# Stage 3 digest (weekly cached ranking snapshot; runs after triage+scoring settle)
DIGEST_SCHEDULE_CRON=0 8 * * 1

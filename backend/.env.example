# backend/.env -- read by docker compose (env_file for db, app, celery-worker, celery-beat)
# and by pydantic Settings (src/config.py). Required: CLERK_DOMAIN, OPENAI_API_KEY;
# TYPESAFE_API_KEY for scoring. Everything else has a code default.
# Host-port overrides (DB_PORT, BACKEND_PORT, FRONTEND_PORT, REDIS_PORT, FLOWER_PORT,
# TEST_DB_PORT) are compose interpolation variables: set them in the shell, not here.

# --- Postgres container (docker-compose.yml `db`) ---
POSTGRES_USER=arxiv_user
POSTGRES_PASSWORD=arxiv_password
POSTGRES_DB=arxiv_rag
# App connection string; `db` is the compose service name. Must agree with the three above.
POSTGRES_URL=postgresql+asyncpg://arxiv_user:arxiv_password@db:5432/arxiv_rag

# --- Auth ---
# Required. Clerk instance domain; JWTs are verified against its JWKS.
CLERK_DOMAIN=your-app.clerk.accounts.dev
CLERK_JWT_AUDIENCE=
CLERK_WEBHOOK_SECRET=
# X-Api-Key for the ops endpoints; empty disables them.
API_KEY=

# --- Provider keys ---
# Required: Stage 1 triage, paper chat and chunk embeddings (text-embedding-3-small) via LiteLLM.
OPENAI_API_KEY=sk-your-key-here
# Required for Stage 2 scoring (TypeSafe Jev). Chat and triage do not use it; the API
# starts without it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT_SECONDS=60

# --- LLM (LiteLLM "provider/model"; one model, no per-request selection) ---
DEFAULT_LLM_MODEL=openai/gpt-5-nano
# Structured-output calls (classify, evaluate, triage). Empty means DEFAULT_LLM_MODEL.
STRUCTURED_OUTPUT_MODEL=openai/gpt-5-nano
DEFAULT_TEMPERATURE=0.3
LLM_CALL_TIMEOUT_SECONDS=60
AGENT_TIMEOUT_SECONDS=180

# --- Semantic Scholar (demand signal; keyless by design) ---
SEMANTIC_SCHOLAR_CACHE_TTL_SECONDS=604800
# The keyless pool is ~1 req/s shared; a Redis slot spaces calls across all workers.
SEMANTIC_SCHOLAR_MIN_INTERVAL_MS=1500
# Nightly retry of demand lookups that soft-failed to NULL.
DEMAND_BACKFILL_SCHEDULE_CRON=0 4 * * *
DEMAND_BACKFILL_BATCH_SIZE=200

# --- Redis (the dev compose redis has no password) ---
# General cache: Semantic Scholar cache + slot, on-demand score locks.
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIMEOUT=600
# On-demand scoring lock TTL (paper detail); the score task releases it early.
ONDEMAND_SCORE_LOCK_SECONDS=1800
# Daily budget for on-demand scoring: global across all users, and per user (UTC day).
ONDEMAND_SCORE_DAILY_BUDGET=30
ONDEMAND_SCORE_DAILY_PER_USER=10

# --- Retrieval and chunking ---
DEFAULT_TOP_K=3
RRF_K=60
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=100
MIN_CHUNK_WORDS=100

# --- Paper-scoped chat agent ---
GUARDRAIL_THRESHOLD=75
MAX_ITERATIONS=5
CONVERSATION_WINDOW=5

# --- Scheduled jobs (cron, UTC) ---
INGEST_SCHEDULE_CRON=0 2 * * *
CLEANUP_SCHEDULE_CRON=0 3 * * *
CLEANUP_RETENTION_DAYS=90
# Stage 1 triage (the scoring pipeline's entry point). TRIAGE_CATEGORIES is a JSON list.
TRIAGE_SCHEDULE_CRON=0 6 * * 1
TRIAGE_CATEGORIES=["cs.LG", "cs.CL", "cs.CV", "cs.AI"]
TRIAGE_LOOKBACK_DAYS=7
TRIAGE_MAX_PER_CATEGORY=100
# Pause between per-category arXiv crawls (arXiv rate limit).
ARXIV_CRAWL_PAUSE_SECONDS=3
# Stage 3 digest; runs after triage + scoring settle.
DIGEST_SCHEDULE_CRON=0 8 * * 1

# --- App ---
# Comma-separated origins; empty blocks all cross-origin requests. Vite proxies /api in dev.
CORS_ORIGINS=http://localhost:5173
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO
# Request/response body logging (production sets both false in docker-compose.coolify.yml).
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
# Maintenance curtain: every API route except health returns 503.
MAINTENANCE_MODE=false

# --- Tracing (Pydantic Logfire; read by the SDK in src/observability.py, not by Settings) ---
# Empty token exports nothing. With a token, every request, SQL statement, LangGraph node,
# LLM call and Celery task is traced, prompts and paper text included.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=dev
# Optional second span exporter, to a self-hosted OTLP collector, alongside Logfire. Read by
# the OTel SDK inside logfire, so no code path changes. Traces only: the bare
# OTEL_EXPORTER_OTLP_ENDPOINT would also export metrics and logs. The endpoint needs the full
# /v1/traces path; headers are comma-separated key=value and the value must not contain a comma.
# Leave both empty in dev: a real value here also exports from local pytest runs.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

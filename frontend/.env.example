# frontend/.env -- read by docker compose (env_file for the frontend dev service) and by
# Vite. In production every VITE_* value is a Docker build arg (frontend/Dockerfile), set in
# docker-compose.coolify.yml.

# Required. Clerk publishable key (pk_test_... for dev).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Optional. 'true' renders the maintenance screen instead of the app.
VITE_MAINTENANCE_MODE=false
# Optional. Browser telemetry (src/lib/observability.ts): the full /collect URL of our
# self-hosted Alloy faro.receiver, e.g. https://faro.example.com/collect. Empty (the default)
# loads no SDK. The api key is a coarse bot filter, not a secret -- it ships in the bundle.
# Setting these here turns telemetry on for `npm run dev` too (the dev service reads this file).
VITE_FARO_URL=
VITE_FARO_API_KEY=
